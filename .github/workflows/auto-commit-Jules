name: Auto Commit Jules Changes

on:
  push:
    branches:
      - main       # Jules의 변경사항이 들어오는 대상 브랜치 이름으로 수정하세요
      - develop
  workflow_dispatch: # GitHub 웹 UI에서 수동 실행도 가능하도록 설정

jobs:
  auto-commit:
    runs-on: ubuntu-latest

    permissions:
      contents: write # 리포지토리에 자동 커밋 및 푸시를 위한 권한

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # 1. 필요 시 Jules의 최신 작업 내용 반영/빌드/스크립트 실행 단계
      - name: Process Jules Updates
        run: |
          echo "Processing Jules changes..."
          # 필요한 경우 파일 정리/포맷팅 스크립트 실행

      # 2. 변경사항 자동 커밋 & 푸시
      - name: Commit and Push Changes
        uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: "auto: apply changes from Jules [skip ci]"
          branch: ${{ github.ref_name }}
          commit_author: "Jules Bot <jules-bot@users.noreply.github.com>"
