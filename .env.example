# NSight Server Environment Configuration
# Groq API Keys (Total 5 keys for Round-Robin rotation & Rate Limit Failover)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Primary Groq Model: qwen/qwen3.8-27b or openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b

# Naver Search API (Optional for Real-time News Retrieval)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Server Port (Default: 3000)
PORT=3000
