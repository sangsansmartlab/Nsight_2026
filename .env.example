# NSight Server Environment Configuration
# Groq API Keys (Total 5 keys for Round-Robin rotation & Rate Limit Failover)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=

# Primary Groq Model: llama-3.3-70b-versatile or llama-3.1-8b-instant
GROQ_MODEL=llama-3.3-70b-versatile

# Naver Search API (Optional for Real-time News Retrieval)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Server Port (Default: 3000)
PORT=3000
